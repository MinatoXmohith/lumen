<?xml version="1.0" encoding="utf-8"?>
<!-- HOME / APPS tabs: white pill when focused, a soft glass pill when it is the current tab. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle"><solid android:color="#F5FFFFFF" /><corners android:radius="20dp" /></shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle"><solid android:color="#33FFFFFF" /><stroke android:width="1dp" android:color="#59FFFFFF" /><corners android:radius="20dp" /></shape>
    </item>
    <item><shape android:shape="rectangle"><solid android:color="#00000000" /><corners android:radius="20dp" /></shape></item>
</selector>
