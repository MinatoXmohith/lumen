<?xml version="1.0" encoding="utf-8"?>
<!-- Round icon buttons (music controls): a solid white disc when focused, a faint glass disc otherwise. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="oval"><solid android:color="#FFFFFFFF" /></shape>
    </item>
    <item>
        <shape android:shape="oval"><solid android:color="#1FFFFFFF" /><stroke android:width="1dp" android:color="#40FFFFFF" /></shape>
    </item>
</selector>
