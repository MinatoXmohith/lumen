<?xml version="1.0" encoding="utf-8"?>
<!-- Menus and the wallpaper screen leave by fading and settling back slightly, instead of vanishing. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@interpolator/exit" android:shareInterpolator="true">
    <alpha android:duration="180" android:fromAlpha="1" android:toAlpha="0" />
    <scale android:duration="180" android:fromXScale="1" android:toXScale="0.97" android:fromYScale="1" android:toYScale="0.97"
        android:pivotX="50%" android:pivotY="0%" />
</set>
