<?xml version="1.0" encoding="utf-8"?>
<!-- APPS opens: the grid grows in from just under the APPS tab. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@interpolator/emphasized" android:shareInterpolator="true">
    <scale android:duration="360" android:fromXScale="0.9" android:toXScale="1" android:fromYScale="0.9" android:toYScale="1"
        android:pivotX="55%" android:pivotY="8%" />
    <alpha android:duration="260" android:fromAlpha="0" android:toAlpha="1" />
</set>
