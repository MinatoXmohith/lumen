<?xml version="1.0" encoding="utf-8"?>
<!-- Home steps back while APPS opens over it. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@interpolator/emphasized" android:shareInterpolator="true">
    <scale android:duration="360" android:fromXScale="1" android:toXScale="1.06" android:fromYScale="1" android:toYScale="1.06"
        android:pivotX="50%" android:pivotY="50%" />
    <alpha android:duration="300" android:fromAlpha="1" android:toAlpha="0" />
</set>
