<?xml version="1.0" encoding="utf-8"?>
<!-- Home (mkdziner design, v5): greeting + date, HOME / APPS tabs, time pill, music card, weather card with
     details, five app tiles. Down from the tiles opens the trending page (BrowseActivity). 960x540 dp. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:background="#FF000000">

    <TextView android:id="@+id/hello" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="52dp" android:layout_marginTop="34dp"
        android:textColor="#FFFFFFFF" android:textSize="19sp" android:fontFamily="@font/outfit_semibold"
        android:letterSpacing="0.03" android:shadowColor="#80000000" android:shadowRadius="10" android:textAllCaps="true" />
    <TextClock android:id="@+id/dashDate" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="52dp" android:layout_marginTop="62dp"
        android:format12Hour="EEEE d MMMM" android:format24Hour="EEEE d MMMM"
        android:textColor="#E6FFFFFF" android:textSize="15sp" android:fontFamily="@font/outfit_medium"
        android:letterSpacing="0.04" android:shadowColor="#80000000" android:shadowRadius="8" android:textAllCaps="true" />

    <LinearLayout android:id="@+id/tabs" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal" android:layout_marginTop="36dp" android:orientation="horizontal">
        <TextView android:id="@+id/tabHome" android:layout_width="wrap_content" android:layout_height="40dp"
            android:paddingStart="22dp" android:paddingEnd="22dp" android:gravity="center" android:text="HOME"
            android:textColor="@drawable/pill_text" android:textSize="15sp" android:fontFamily="@font/outfit_semibold"
            android:letterSpacing="0.06" android:background="@drawable/tab_bg" android:focusable="true" android:clickable="true" />
        <TextView android:id="@+id/tabApps" android:layout_width="wrap_content" android:layout_height="40dp"
            android:layout_marginStart="12dp"
            android:paddingStart="22dp" android:paddingEnd="22dp" android:gravity="center" android:text="APPS"
            android:textColor="@drawable/pill_text" android:textSize="15sp" android:fontFamily="@font/outfit_semibold"
            android:letterSpacing="0.06" android:background="@drawable/tab_bg" android:focusable="true" android:clickable="true" />
    </LinearLayout>

    <LinearLayout android:id="@+id/btnStatus" android:layout_width="wrap_content" android:layout_height="46dp"
        android:layout_gravity="top|end" android:layout_marginTop="30dp" android:layout_marginEnd="52dp"
        android:paddingStart="18dp" android:paddingEnd="5dp" android:gravity="center_vertical"
        android:orientation="horizontal" android:focusable="true" android:clickable="true"
        android:background="@drawable/pill_bg" android:contentDescription="@string/settings">
        <TextClock android:id="@+id/statusClock" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:duplicateParentState="true" android:format12Hour="h:mm a" android:format24Hour="HH:mm"
            android:textColor="@drawable/pill_text" android:textSize="17sp" android:fontFamily="@font/outfit_medium"
            android:shadowColor="#73000000" android:shadowRadius="6" android:includeFontPadding="false" />
        <ImageView android:id="@+id/avatar" android:layout_width="36dp" android:layout_height="36dp"
            android:layout_marginStart="11dp" android:duplicateParentState="true" android:importantForAccessibility="no" />
    </LinearLayout>

    <!-- Music player -->
    <LinearLayout android:id="@+id/musicCard" android:layout_width="415dp" android:layout_height="186dp"
        android:layout_marginStart="52dp" android:layout_marginTop="168dp" android:padding="18dp"
        android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:id="@+id/musicArt" android:layout_width="150dp" android:layout_height="150dp"
            android:scaleType="centerCrop" android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:layout_marginStart="18dp" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="NOW PLAYING"
                android:textColor="#B3FFFFFF" android:textSize="11sp" android:fontFamily="@font/outfit_medium" android:letterSpacing="0.14" />
            <TextView android:id="@+id/musicTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:maxLines="2" android:ellipsize="end" android:textColor="#FFFFFFFF"
                android:textSize="20sp" android:fontFamily="@font/outfit_semibold" android:shadowColor="#66000000" android:shadowRadius="6" />
            <TextView android:id="@+id/musicArtist" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:singleLine="true" android:ellipsize="end" android:textColor="#D9FFFFFF" android:textSize="13sp"
                android:fontFamily="@font/outfit_regular" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:orientation="horizontal">
                <ImageView android:id="@+id/musicPrev" android:layout_width="46dp" android:layout_height="46dp" android:padding="11dp"
                    android:src="@drawable/ic_prev" android:tint="@drawable/pill_text" android:background="@drawable/rail_btn_bg"
                    android:focusable="true" android:clickable="true" android:contentDescription="Previous" />
                <ImageView android:id="@+id/musicPlay" android:layout_width="46dp" android:layout_height="46dp" android:layout_marginStart="12dp"
                    android:padding="9dp" android:src="@drawable/ic_play" android:tint="@drawable/pill_text" android:background="@drawable/rail_btn_bg"
                    android:focusable="true" android:clickable="true" android:contentDescription="Play or pause" />
                <ImageView android:id="@+id/musicNext" android:layout_width="46dp" android:layout_height="46dp" android:layout_marginStart="12dp"
                    android:padding="9dp" android:src="@drawable/ic_next" android:tint="@drawable/pill_text" android:background="@drawable/rail_btn_bg"
                    android:focusable="true" android:clickable="true" android:contentDescription="Next" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Weather: main card + details panel -->
    <LinearLayout android:id="@+id/weatherMain" android:layout_width="280dp" android:layout_height="186dp"
        android:layout_marginStart="493dp" android:layout_marginTop="168dp" android:paddingStart="20dp" android:paddingEnd="14dp"
        android:gravity="center_vertical" android:orientation="vertical">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView android:id="@+id/weatherTemp" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="--°" android:textColor="#FFFFFFFF" android:textSize="62sp" android:fontFamily="@font/outfit_medium"
                android:includeFontPadding="false" android:letterSpacing="-0.03" android:shadowColor="#66000000" android:shadowRadius="10" />
            <TextView android:id="@+id/weatherIcon" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="12dp" android:textSize="40sp" />
        </LinearLayout>
        <TextView android:id="@+id/weatherNow" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:singleLine="true" android:ellipsize="end" android:textColor="#FFFFFFFF"
            android:textSize="21sp" android:fontFamily="@font/outfit_semibold" android:shadowColor="#66000000" android:shadowRadius="6" />
        <TextView android:id="@+id/weatherRange" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:singleLine="true" android:textColor="#F2FFFFFF" android:textSize="16sp" android:fontFamily="@font/outfit_medium"
            android:shadowColor="#66000000" android:shadowRadius="6" />
        <TextView android:id="@+id/weatherCity" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:singleLine="true" android:textColor="#CCFFFFFF" android:textSize="11sp"
            android:fontFamily="@font/outfit_medium" android:letterSpacing="0.14" android:textAllCaps="true" />
    </LinearLayout>
    <LinearLayout android:id="@+id/weatherStats" android:layout_width="128dp" android:layout_height="186dp"
        android:layout_marginStart="780dp" android:layout_marginTop="168dp" android:paddingTop="6dp" android:paddingBottom="6dp"
        android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="14dp">
                <TextView android:layout_width="26dp" android:layout_height="wrap_content" android:text="🌡️"
                    android:textSize="16sp" android:gravity="center" />
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="8dp" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Feels like"
                        android:textColor="#D9FFFFFF" android:textSize="11sp" android:fontFamily="@font/outfit_medium" />
                    <TextView android:id="@+id/stat0" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="#FFFFFFFF" android:textSize="12sp" android:fontFamily="@font/outfit_semibold" android:singleLine="true"
                        android:shadowColor="#66000000" android:shadowRadius="5" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="14dp">
                <TextView android:layout_width="26dp" android:layout_height="wrap_content" android:text="☀️"
                    android:textSize="16sp" android:gravity="center" />
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="8dp" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="UV index"
                        android:textColor="#D9FFFFFF" android:textSize="11sp" android:fontFamily="@font/outfit_medium" />
                    <TextView android:id="@+id/stat1" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="#FFFFFFFF" android:textSize="12sp" android:fontFamily="@font/outfit_semibold" android:singleLine="true"
                        android:shadowColor="#66000000" android:shadowRadius="5" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="14dp">
                <TextView android:layout_width="26dp" android:layout_height="wrap_content" android:text="💨"
                    android:textSize="16sp" android:gravity="center" />
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="8dp" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Wind"
                        android:textColor="#D9FFFFFF" android:textSize="11sp" android:fontFamily="@font/outfit_medium" />
                    <TextView android:id="@+id/stat2" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="#FFFFFFFF" android:textSize="12sp" android:fontFamily="@font/outfit_semibold" android:singleLine="true"
                        android:shadowColor="#66000000" android:shadowRadius="5" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="14dp">
                <TextView android:layout_width="26dp" android:layout_height="wrap_content" android:text="☁️"
                    android:textSize="16sp" android:gravity="center" />
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="8dp" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cloud cover"
                        android:textColor="#D9FFFFFF" android:textSize="11sp" android:fontFamily="@font/outfit_medium" />
                    <TextView android:id="@+id/stat3" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="#FFFFFFFF" android:textSize="12sp" android:fontFamily="@font/outfit_semibold" android:singleLine="true"
                        android:shadowColor="#66000000" android:shadowRadius="5" />
                </LinearLayout>
            </LinearLayout>
    </LinearLayout>

    <!-- Five favourite apps -->
    <LinearLayout android:id="@+id/appRow" android:layout_width="856dp" android:layout_height="76dp"
        android:layout_marginStart="52dp" android:layout_marginTop="396dp" android:orientation="horizontal"
        android:clipChildren="false" android:clipToPadding="false" />

    <TextView android:id="@+id/trendingHint" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal" android:layout_marginTop="498dp"
        android:text="▾  TRENDING THIS WEEK" android:textColor="#CCFFFFFF" android:textSize="12sp"
        android:fontFamily="@font/outfit_medium" android:letterSpacing="0.16" android:shadowColor="#80000000" android:shadowRadius="8" />
</FrameLayout>
